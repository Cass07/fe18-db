": "비선호"}, {"label": "MID_SV_Meal_Urs_m03_02", "name": "우술라", "text": "좋은 점이 하나도 없네요……", "type": "비선호"}, {"label": "MID_SV_Meal_Sim_m03_01", "name": "시몬", "text": "하필 이거냐. 그래도 참고 먹어야겠지……", "type": "비선호"}, {"label": "MID_SV_Meal_Sim_m03_02", "name": "시몬", "text": "으…… 다 먹으려면 고생 좀 하겠군.", "type": "비선호"}, {"label": "MID_SV_Meal_Lou_m03_01", "name": "루루디아", "text": "싫어도 다 먹어야 해, 루루……!", "type": "비선호"}, {"label": "MID_SV_Meal_Lou_m03_02", "name": "루루디아", "text": "으음…… 참으면 어떻게든……", "type": "비선호"}, {"label": "MID_SV_Meal_Fia_m03_01", "name": "피아나", "text": "으…… 조금씩 먹어야겠어요……", "type": "비선호"}, {"label": "MID_SV_Meal_Fia_m03_02", "name": "피아나", "text": "제 취향은 아니지만…… 그래도 요리니까……", "type": "비선호"}, {"label": "MID_SV_Meal_Die_m03_01", "name": "디에고", "text": "윽……! 이걸로 충분하다.", "type": "비선호"}, {"label": "MID_SV_Meal_Die_m03_02", "name": "디에고", "text": "이건…… 먹어도 힘이 날 것 같지는 않군……", "type": "비선호"}, {"label": "MID_SV_Meal_Lor0_m03_01", "name": "로레타", "text": "아, 아무것도 못 먹는 것보다는…… 으으……", "type": "비선호"}, {"label": "MID_SV_Meal_Lor0_m03_02", "name": "로레타", "text": "어떻게든 삼켜 버리면……!", "type": "비선호"}, {"label": "MID_SV_Meal_Lor1_m03_01", "name": "로레타", "text": "뒷골목에 살 때 먹던 걸 생각하면……", "type": "비선호"}, {"label": "MID_SV_Meal_Lor1_m03_02", "name": "로레타", "text": "남기는 건 예의가 아니겠지…… 우웁.", "type": "비선호"}, {"label": "MID_SV_Meal_Set_m03_01", "name": "세테스", "text": "음식을 낭비할 수는 없지……", "type": "비선호"}, {"label": "MID_SV_Meal_Set_m03_02", "name": "세테스", "text": "내 입에는 안 맞군……", "type": "비선호"}, {"label": "MID_SV_Meal_Nin_m03_01", "name": "리네", "text": "리네 입에는…… 안 맞아……", "type": "비선호"}, {"label": "MID_SV_Meal_Nin_m03_02", "name": "리네", "text": "……! 이거 맛없어.", "type": "비선호"}, {"label": "MID_SV_Meal_Bon_m03_01", "name": "보나파르트", "text": "………………음.<br>으음……", "type": "비선호"}, {"label": "MID_SV_Meal_Bon_m03_02", "name": "보나파르트", "text": "시련은 식사할 때도 찾아오는군……", "type": "비선호"}, {"label": "MID_SV_Meal_Tob_m03_01", "name": "토비아스", "text": "으으, 다 먹고 나면 좋아하는 걸 먹어야겠구먼……", "type": "비선호"}, {"label": "MID_SV_Meal_Tob_m03_02", "name": "토비아스", "text": "이걸 먹어야 하는 건가……", "type": "비선호"}, {"label": "MID_SV_Meal_Lil_m03_01", "name": "릴리안", "text": "좀 봐줘…… 이거 싫단 말이야……", "type": "비선호"}, {"label": "MID_SV_Meal_Lil_m03_02", "name": "릴리안", "text": "우웩…… 이건 진짜 아니야……", "type": "비선호"}, {"label": "MID_SV_Meal_Lys_m03_01", "name": "라이선더", "text": "이 정도는 다 먹어야……<br>윽……", "type": "비선호"}, {"label": "MID_SV_Meal_Lys_m03_02", "name": "라이선더", "text": "굶주림에 허덕이는 이들도 있으니……!", "type": "비선호"}, {"label": "MID_SV_Meal_Buc_m03_01", "name": "버커니어", "text": "전장에서 먹는 밥보다는 낫나……", "type": "비선호"}, {"label": "MID_SV_Meal_Buc_m03_02", "name": "버커니어", "text": "이것도 소중한 양식이라 생각하면……!", "type": "비선호"}, {"label": "MID_SV_Meal_Sci_m03_01", "name": "시로코", "text": "울적한 기분이 들게 하는 맛이군……", "type": "비선호"}, {"label": "MID_SV_Meal_Sci_m03_02", "name": "시로코", "text": "여성은 개성이 강해도 매력적이지만<br>요리의 맛과 풍미가 독특한 건 좀……", "type": "비선호"}, {"label": "MID_SV_Meal_Moo0_m03_01", "name": "무우", "text": "더 쓰면 먹기 편할 텐데……", "type": "비선호"}, {"label": "MID_SV_Meal_Moo0_m03_02", "name": "무우", "text": "우웩…… 빨리 먹어 버리자……", "type": "비선호"}, {"label": "MID_SV_Meal_Moo1_m03_01", "name": "무우", "text": "이거 다 먹을 수 있을까……", "type": "비선호"}, {"label": "MID_SV_Meal_Moo1_m03_02", "name": "무우", "text": "참고 먹어야 해……!", "type": "비선호"}, {"label": "MID_SV_Meal_Oly_m03_01", "name": "올림피아", "text": "내 입에는 맞지 않는 것 같네요……", "type": "비선호"}, {"label": "MID_SV_Meal_Oly_m03_02", "name": "올림피아", "text": "……축 처지게 만드는 맛이네요.", "type": "비선호"}, {"label": "MID_SV_Meal_Naz_m03_01", "name": "나타", "text": "정말 이걸 먹어야 하는 건가……", "type": "비선호"}, {"label": "MID_SV_Meal_Naz_m03_02", "name": "나타", "text": "윽…… 이거 너무 맵잖아!", "type": "비선호"}, {"label": "MID_SV_Meal_Sar_m03_01", "name": "사란", "text": "뭐, 먹을 수는 있지만……", "type": "비선호"}, {"label": "MID_SV_Meal_Sar_m03_02", "name": "사란", "text": "식욕이 별로 없네……", "type": "비선호"}, {"label": "MID_SV_Meal_Dai_m03_01", "name": "대도", "text": "이런 걸 누가 먹어……", "type": "비선호"}, {"label": "MID_SV_Meal_Dai_m03_02", "name": "대도", "text": "우웩, 역시 다른 것을 먹을 걸 그랬어……", "type": "비선호"}, {"label": "MID_SV_Meal_Hal_m03_01", "name": "하르빈", "text": "이, 이 요리는 내 취향이 아닐지도. 잘 모르겠지만……", "type": "비선호"}, {"label": "MID_SV_Meal_Hal_m03_02", "name": "하르빈", "text": "먹을 수 있다는 것만으로도 행복한 거야……!", "type": "비선호"}, {"label": "MID_SV_Meal_Guj_m03_01", "name": "그자람", "text": "신만큼이나 입이 고급인 내 취향에는 좀 안 맞는군.", "type": "비선호"}, {"label": "MID_SV_Meal_Guj_m03_02", "name": "그자람", "text": "억지로라도 먹어야 하나……?", "type": "비선호"}, {"label": "MID_SV_Meal_Yan_m03_01", "name": "양계", "text": "이 맛은…… 고행이나 다름없군……", "type": "비선호"}, {"label": "MID_SV_Meal_Yan_m03_02", "name": "양계", "text": "남기는 건 도에 어긋나겠지……", "type": "비선호"}, {"label": "MID_SV_Meal_Iio_m03_01", "name": "이오", "text": "……그냥 삼키면 된다.", "type": "비선호"}, {"label": "MID_SV_Meal_Iio_m03_02", "name": "이오", "text": "먹을 수밖에 없나……", "type": "비선호"}, {"label": "MID_SV_Meal_Pep_m03_01", "name": "페페", "text": "음식을 남길 수는 없다……!", "type": "비선호"}, {"label": "MID_SV_Meal_Pep_m03_02", "name": "페페", "text": "이, 이게 바로 문화 충격이라는 것인가……!", "type": "비선호"}, {"label": "MID_SV_Meal_Noc_m03_01", "name": "녹투라", "text": "안 좋은 의미로…… 이런 건 처음 먹어 보네.", "type": "비선호"}, {"label": "MID_SV_Meal_Noc_m03_02", "name": "녹투라", "text": "뭘로 만들었길래 이런 맛이 날까……", "type": "비선호"}, {"label": "MID_SV_Meal_Sop_m03_01", "name": "소피아", "text": "배를 채울 수 있다면 내 취향이 아니라도 상관없어.", "type": "비선호"}, {"label": "MID_SV_Meal_Sop_m03_02", "name": "소피아", "text": "배를 채우는 게 가장 중요하지! 맛은 나중 문제야!", "type": "비선호"}, {"label": "MID_SV_Meal_Cat_m03_01", "name": "카타냐", "text": "이 맛…… 죄송하지만 제 취향은 아니에요.", "type": "비선호"}, {"label": "MID_SV_Meal_Cat_m03_02", "name": "카타냐", "text": "싫다고 도망치는 건 기사의 수치겠지……!", "type": "비선호"}, {"label": "MID_SV_Meal_Ned_m03_01", "name": "누디누", "text": "불평할 입장은 아니지만……", "type": "비선호"}, {"label": "MID_SV_Meal_Ned_m03_02", "name": "누디누", "text": "맛은 없지만 영양 보충은 되겠지……", "type": "비선호"}, {"label": "MID_SV_Meal_Zac_m03_01", "name": "자코네", "text": "더 맛있는 거 없냐고!", "type": "비선호"}, {"label": "MID_SV_Meal_Zac_m03_02", "name": "자코네", "text": "산적이 더 잘 만들겠다……", "type": "비선호"}, {"label": "MID_SV_Meal_Maj_m03_01", "name": "마지데", "text": "맛없는 건 안 씹고 삼키는 게 상책이지!", "type": "비선호"}, {"label": "MID_SV_Meal_Maj_m03_02", "name": "마지데", "text": "감옥에서 먹는 밥보다는…… 맛있지만……", "type": "비선호"}, {"label": "MID_SV_Meal_Ven_m03_01", "name": "밴디츠", "text": "마음에 안 든다! 뭐냐, 이 맛은!!", "type": "비선호"}, {"label": "MID_SV_Meal_Ven_m03_02", "name": "밴디츠", "text": "왜 내가 이 나이에 싫어하는 것을 먹어야 하는 거냐!", "type": "비선호"}, {"label": "MID_SV_Meal_Ini_m03_01", "name": "이니오니", "text": "남기면 안 돼…… 참고 먹자……", "type": "비선호"}, {"label": "MID_SV_Meal_Ini_m03_02", "name": "이니오니", "text": "시간이 걸리더라도 다 먹어야 해……", "type": "비선호"}, {"label": "MID_SV_Meal_Jas_m03_01", "name": "자스민", "text": "윽…… 내가 싫어하는 거잖아……", "type": "비선호"}, {"label": "MID_SV_Meal_Jas_m03_02", "name": "자스민", "text": "이 맛은 정말…… 기분이 우울해지네……", "type": "비선호"}, {"label": "MID_SV_Meal_Ale_m03_01", "name": "알렉산드라", "text": "으으…… 어떻게든 다 먹어야 해요……", "type": "비선호"}, {"label": "MID_SV_Meal_Ale_m03_02", "name": "알렉산드라", "text": "요리는 요리니 남기지 않겠어요……", "type": "비선호"}, {"label": "MID_SV_Meal_Nat_m03_01", "name": "네이선", "text": "음식을 남기는 건 부끄러운 일이지……", "type": "비선호"}, {"label": "MID_SV_Meal_Nat_m03_02", "name": "네이선", "text": "지금 내게 필요한 것은 삼킬 각오다……!", "type": "비선호"}, {"label": "MID_SV_Meal_Hri_m03_01", "name": "키릭", "text": "……고행이라고 해도 무방할 정도군.", "type": "비선호"}, {"label": "MID_SV_Meal_Hri_m03_02", "name": "키릭", "text": "……물로 입안을 좀 헹궈야겠군.", "type": "비선호"}, {"label": "MID_SV_Meal_Tro_m03_01", "name": "트로이아", "text": "이걸 맛있다고 생각하는 녀석이 있다니……", "type": "비선호"}, {"label": "MID_SV_Meal_Tro_m03_02", "name": "트로이아", "text": "식욕을 떨어뜨리는 맛이네……", "type": "비선호"}, {"label": "MID_SV_Meal_Cen_m03_01", "name": "센트리온", "text": "음…… 남기지는 않겠다.", "type": "비선호"}, {"label": "MID_SV_Meal_Cen_m03_02", "name": "센트리온", "text": "이것도 몸과 마음의 양식이라 생각하면……!", "type": "비선호"}, {"label": "MID_SV_Meal_Asw_m03_01", "name": "아스완", "text": "음식을 남길 수는 없어……", "type": "비선호"}, {"label": "MID_SV_Meal_Asw_m03_02", "name": "아스완", "text": "찌푸린 얼굴로 먹는 건 실례겠지.", "type": "비선호"}, {"label": "MID_SV_Meal_Kou_m03_01", "name": "홍화", "text": "어떻게 만들었길래 이런 맛이 나지……", "type": "비선호"}, {"label": "MID_SV_Meal_Kou_m03_02", "name": "홍화", "text": "마을에서 살던 시절을 생각하면……!", "type": "비선호"}, {"label": "MID_SV_Meal_Nuz_m03_01", "name": "누조", "text": "으윽…… 고통을 동반하는 식사군……", "type": "비선호"}, {"label": "MID_SV_Meal_Nuz_m03_02", "name": "누조", "text": "식량을 낭비할 수는 없다……!", "type": "비선호"}, {"label": "MID_SV_Meal_Kir_m03_01", "name": "키로이카", "text": "냄새나는 밥을 먹는 것보다는 낫나……", "type": "비선호"}, {"label": "MID_SV_Meal_Kir_m03_02", "name": "키로이카", "text": "아악! 이 맛은 정말! 최악이야!", "type": "비선호"}, {"label": "MID_SV_Meal_Anh_Sci_m01_01", "name": "시로코", "text": "가슴에 찬바람이 거세게 부는 날 아나톨리아양과<br>식사를 할 수 있다니. 내가 바람을 잘 탔나 보군.", "type": "상호"}, {"label": "MID_SV_Meal_Anh_Sci_m01_02", "name": "아나톨리아", "text": "우연이 겹쳤을 뿐, 바람하고는 상관없어요.<br>점괘에서도 그렇게 나오겠죠.", "type": "상호"}, {"label": "MID_SV_Meal_Anh_Yan_m01_01", "name": "양계", "text": "하나같이 정말 맛있군!<br>아무리 먹고 마셔도 부족할 정도로다!", "type": "상호"}, {"label": "MID_SV_Meal_Anh_Yan_m01_02", "name": "아나톨리아", "text": "지나친 폭음과 폭식……<br>절제와는 거리가 멀군요.", "type": "상호"}, {"label": "MID_SV_Meal_Esm_Jes_m01_01", "name": "제스터", "text": "히힛, 즐거워.<br>장난감을 베는 쾌감과 비슷하네.", "type": "상호"}, {"label": "MID_SV_Meal_Esm_Jes_m01_02", "name": "에스메랄다", "text": "뭔가 어색한 말투네.<br>그냥 솔직하게 맛있다고 하면 될 텐데.", "type": "상호"}, {"label": "MID_SV_Meal_Orh_Die_m01_01", "name": "오르헬", "text": "디에고가 많이 먹는 모습을 보면<br>왠지 기분이 좋아져.", "type": "상호"}, {"label": "MID_SV_Meal_Orh_Die_m01_02", "name": "디에고", "text": "그렇게 쳐다보면 조금 먹기 힘들지만……<br>오르헬이 기뻐한다면야 얼마든지 먹을 수 있어.", "type": "상호"}, {"label": "MID_SV_Meal_Orh_Maj_m01_01", "name": "오르헬", "text": "정말 잘 드시네요.<br>어렸을 때도 편식은 안 하셨나요?", "type": "상호"}, {"label": "MID_SV_Meal_Orh_Maj_m01_02", "name": "마지데", "text": "그래, 뭐든 다 먹었지!<br>음식을 가린다는 건 사치에 불과했으니까!", "type": "상호"}, {"label": "MID_SV_Meal_Kai1_Ale_m01_01", "name": "카이", "text": "다 맛있네…… 어라?<br>알렉산드라 누나, 안 먹어?", "type": "상호"}, {"label": "MID_SV_Meal_Kai1_Ale_m01_02", "name": "알렉산드라", "text": "물론 먹을 거예요!<br>카이씨가 맛있게 드셔서 저도 모르게 빤히 쳐다봤네요.", "type": "상호"}, {"label": "MID_SV_Meal_Kai1_Hur_m01_01", "name": "울턴드", "text": "후후후, 엄청 맛있게 먹네.", "type": "상호"}, {"label": "MID_SV_Meal_Kai1_Hur_m01_02", "name": "카이", "text": "친한 사람과 식사를 하면<br>평소보다 더 맛있게 느껴지거든!", "type": "상호"}, {"label": "MID_SV_Meal_Gat_Urs_m01_01", "name": "게이츠", "text": "이 나이에도 딱딱한 음식을 먹을 때 고생하지 않는 건<br>몸의 노화가 느린 덕분이지.", "type": "상호"}, {"label": "MID_SV_Meal_Gat_Urs_m01_02", "name": "우술라", "text": "맞아요.<br>덕분에 어떤 요리든 즐길 수 있죠.", "type": "상호"}, {"label": "MID_SV_Meal_Gat_Dan_m01_01", "name": "단테", "text": "먹는 모습도 곧게 뻗은 거목 같군!<br>나도 좀 따라 해 볼까.", "type": "상호"}, {"label": "MID_SV_Meal_Gat_Dan_m01_02", "name": "게이츠", "text": "넌 단정하지 못하니<br>자세를 바로잡으면 조금은 나아지겠지.", "type": "상호"}, {"label": "MID_SV_Meal_Gol_Gat_m01_01", "name": "골라이어스", "text": "꿀꺽…… 크아, 맛있구먼!<br>형씨도 보고 있지만 말고 빨리 먹어!", "type": "상호"}, {"label": "MID_SV_Meal_Gol_Gat_m01_02", "name": "게이츠", "text": "호쾌하게 먹는군!<br>보고 있으면 속이 시원해진다.", "type": "상호"}, {"label": "MID_SV_Meal_Gol_Lor0_m01_01", "name": "로레타", "text": "우와, 크다! 한입이 엄청 커……!<br>나도 당신이랑 같은 양을 한입에 먹어 볼래!", "type": "상호"}, {"label": "MID_SV_Meal_Gol_Lor0_m01_02", "name": "골라이어스", "text": "이상한 도전하지 말고 제대로 먹어라.<br>정말이지, 말괄량이 돌보기는 힘들구먼.", "type": "상호"}, {"label": "MID_SV_Meal_Sar_Dai_m01_01", "name": "사란", "text": "어머, 대도. 벌써 다 먹었어?<br>옛날부터 그랬지만 보기와는 달리 별로 안 먹네.", "type": "상호"}, {"label": "MID_SV_Meal_Sar_Dai_m01_02", "name": "대도", "text": "사란의 위장이 대단한 것뿐이라고……<br>하지만 질 수 없지! 더 먹어 주겠어!", "type": "상호"}, {"label": "MID_SV_Meal_Jes_Dan_m01_01", "name": "단테", "text": "안 돼, 안 돼! 피를 마시며 황홀해하는 듯한<br>표정을 지으며 먹는 거다! 자, 어서!", "type": "상호"}, {"label": "MID_SV_Meal_Jes_Dan_m01_02", "name": "제스터", "text": "히힛, 식사 중에 명령을 하다니……<br>혀가 잘리고 싶으면 더 말해 봐.", "type": "상호"}, {"label": "MID_SV_Meal_Sim_Lou_m01_01", "name": "루루디아", "text": "시몬씨, 식사 중이니<br>전장 이야기는 자제해 주세요.", "type": "상호"}, {"label": "MID_SV_Meal_Sim_Lou_m01_02", "name": "시몬", "text": "미안, 미안.<br>이건 아직 아가씨가 들을 만한 이야기가 아니었나.", "type": "상호"}, {"label": "MID_SV_Meal_Sci_Oly_m01_01", "name": "시로코", "text": "역시 \"카엘루스의 푸른 장미\"야.<br>먹는 모습도 아름다워. 식사 자리에 꽃이 핀 것 같군.", "type": "상호"}, {"label": "MID_SV_Meal_Sci_Oly_m01_02", "name": "올림피아", "text": "후후, 당연하죠. 언제든지<br>아름답게 피어날 수 있도록 준비하고 있으니까요.", "type": "상호"}, {"label": "MID_SV_Meal_Set_Nin_m01_01", "name": "세테스", "text": "익숙한 맛도 좋지만<br>이국의 요리도 자극적이라 흥미롭군.", "type": "상호"}, {"label": "MID_SV_Meal_Set_Nin_m01_02", "name": "리네", "text": "맞아. 리네도 계속 신전에 있었어서<br>밖에서 먹는 요리는 항상 기대돼.", "type": "상호"}, {"label": "MID_SV_Meal_Dai_Hal_m01_01", "name": "대도", "text": "엄청 맛있네! 하르빈도 먹어!<br>우걱우걱…… 읍!?", "type": "상호"}, {"label": "MID_SV_Meal_Dai_Hal_m01_02", "name": "하르빈", "text": "어, 어어!?<br>목에 걸린 거야!? 잘 모르겠지만!?", "type": "상호"}, {"label": "MID_SV_Meal_Tal_Kir_m01_01", "name": "키로이카", "text": "망할 녀석, 벌레 들어간 음식 먹고 배탈이나 나라.<br>쓰레기 녀석, 전 재산 날리고 절망하면서 울어라.", "type": "상호"}, {"label": "MID_SV_Meal_Tal_Kir_m01_02", "name": "타리문", "text": "더러운 녀석, 입 다물고 먹어.<br>식사 중이잖냐.", "type": "상호"}, {"label": "MID_SV_Meal_Tal_Fia_m01_01", "name": "피아나", "text": "당신과 함께 식사할 수 있어서 기뻐요.<br>이 시간이 영원히 지속되면 좋을 텐데……", "type": "상호"}, {"label": "MID_SV_Meal_Tal_Fia_m01_02", "name": "타리문", "text": "이 몸이라도 그건 불가능하지만……<br>너와의 식사는 여러모로 자극적이라 즐겁군.", "type": "상호"}, {"label": "MID_SV_Meal_Dan_Sci_m01_01", "name": "단테", "text": "이 요리로 사람을 유혹한다면 어떤 시를 만들 거지?<br>역시 피부에 비유할 건가? 아니면……", "type": "상호"}, {"label": "MID_SV_Meal_Dan_Sci_m01_02", "name": "시로코", "text": "단테양의 열정은 마치 얼음덩이를 녹이는 열풍 같군.<br>그 바람이 나를 향해 불지 않는 건 아쉽지만 말이야.", "type": "상호"}, {"label": "MID_SV_Meal_Tia1_Pet1_m01_01", "name": "티아라", "text": "피터르는 예나 지금이나 빨리 먹네.<br>그러고도 배탈이 나지 않는 게 신기해.", "type": "상호"}, {"label": "MID_SV_Meal_Tia1_Pet1_m01_02", "name": "피터르", "text": "사실은 좀 더 음미하면서 먹고 싶은데<br>손이 멈추지 않아서…… 에헤헤.", "type": "상호"}, {"label": "MID_SV_Meal_Tia1_Bon_m01_01", "name": "티아라", "text": "강의는 정말 재미있는데……<br>이제 보나파르트씨도 드세요.", "type": "상호"}, {"label": "MID_SV_Meal_Tia1_Bon_m01_02", "name": "보나파르트", "text": "흥이 나서 그만 무례를 범했군……<br>지금은 너와의 식사를 즐겨야겠지.", "type": "상호"}, {"label": "MID_SV_Meal_Dit_Cat_m01_01", "name": "카타냐", "text": "좋아하는 거랑 싫어하는 게 뭔지 자세히 말해 주세요.<br>저도 알려 드릴 테니까요!", "type": "상호"}, {"label": "MID_SV_Meal_Dit_Cat_m01_02", "name": "디트리히", "text": "알 필요가 있나……?<br>조용히 하고 먹어라……", "type": "상호"}, {"label": "MID_SV_Meal_Die_Lor0_m01_01", "name": "로레타", "text": "디에고! 이거 엄청 맛있어!<br>당신도 먹어 봐!", "type": "상호"}, {"label": "MID_SV_Meal_Die_Lor0_m01_02", "name": "디에고", "text": "남겨 뒀다가 나중에 먹으려고 했다만.<br>……그래, 확실히 맛있군.", "type": "상호"}, {"label": "MID_SV_Meal_Tob_Oly_m01_01", "name": "토비아스", "text": "너, 왜 이렇게 조금씩 먹어~<br>한입 가득 먹는 게 더 맛있다고~!", "type": "상호"}, {"label": "MID_SV_Meal_Tob_Oly_m01_02", "name": "올림피아", "text": "먹는 방법에 따라 맛이 달라지나요?<br>그래도 그런 상스러운 짓은 하지 않을 거지만요!", "type": "상호"}, {"label": "MID_SV_Meal_Naz_Sar_m01_01", "name": "나타", "text": "헤헷, 마을에서는 못 먹는 것들뿐이네!<br>엄청 맛있으니까 사란도 먹어 봐!", "type": "상호"}, {"label": "MID_SV_Meal_Naz_Sar_m01_02", "name": "사란", "text": "잠깐, 나타!<br>얌전히 좀 먹어.", "type": "상호"}, {"label": "MID_SV_Meal_Naz_Hal_m01_01", "name": "하르빈", "text": "후훗, 나타는 잘 먹네.<br>성장기인가? 잘 모르겠지만.", "type": "상호"}, {"label": "MID_SV_Meal_Naz_Hal_m01_02", "name": "나타", "text": "아니야! 이 몸에 성장기가 있을 리……<br>아아, 젠장! 이렇게 된 이상 분노의 폭식이다!", "type": "상호"}, {"label": "MID_SV_Meal_Nin_Noc_m01_01", "name": "리네", "text": "……리네도 그거 먹으려고 했는데.<br>당신도 정령의 목소리가 들려?", "type": "상호"}, {"label": "MID_SV_Meal_Nin_Noc_m01_02", "name": "녹투라", "text": "뭐어? 무슨 말인지 모르겠지만……<br>먹고 싶다면 조금 나눠 줄게.", "type": "상호"}, {"label": "MID_SV_Meal_Buc_Moo0_m01_01", "name": "버커니어", "text": "……음? 입이 짧군.<br>영양을 더 많이 섭취하지 않으면 힘이 안 날 거다.", "type": "상호"}, {"label": "MID_SV_Meal_Buc_Moo0_m01_02", "name": "무우", "text": "이, 이제 충분한데…… 으음.<br>한 그릇 더 받을 수 있는지 물어볼게!", "type": "상호"}, {"label": "MID_SV_Meal_Pet0_Hur_m01_01", "name": "울턴드", "text": "많이 먹는 건 좋은데<br>꼭꼭 씹어 먹어야 해!", "type": "상호"}, {"label": "MID_SV_Meal_Pet0_Hur_m01_02", "name": "피터르", "text": "아, 맛있으면 나도 모르게……<br>어머니한테도 자주 지적받거든.", "type": "상호"}, {"label": "MID_SV_Meal_Fia_Cen_m01_01", "name": "센트리온", "text": "음…… 식사는 제대로 하나?<br>왠지 야윈 것 같은데……", "type": "상호"}, {"label": "MID_SV_Meal_Fia_Cen_m01_02", "name": "피아나", "text": "아니에요…… 건강하게 지내고 있어요.<br>다들 저한테 잘해 주시거든요.", "type": "상호"}, {"label": "MID_SV_Meal_Bel_Asw_m01_01", "name": "아스완", "text": "그거 알아? 나, 옛날엔 다 못 먹을 것 같으면<br>몰래 당신 접시에 덜곤 했어.", "type": "상호"}, {"label": "MID_SV_Meal_Bel_Asw_m01_02", "name": "베르트랑", "text": "그래서 먹어도 먹어도 줄지 않았지.<br>네가 웃음을 참는 모습을 보고 금방 눈치챘어.", "type": "상호"}, {"label": "MID_SV_Meal_Bel_Max_m01_01", "name": "맥심", "text": "아무 거리낌 없이 제 본모습을 드러낸 채<br>당신과 식사를 할 수 있어서 매우 행복합니다.", "type": "상호"}, {"label": "MID_SV_Meal_Bel_Max_m01_02", "name": "베르트랑", "text": "나한테도 고마운 일이다.<br>평화를 되찾은 후에도 함께 식사를 즐기자고.", "type": "상호"}, {"label": "MID_SV_Meal_Bon_Lys_m01_01", "name": "라이선더", "text": "보나파르트님을 독점해서 남들에게 미안하지만<br>함께 식사를 할 수 있다니 기쁘기 그지없습니다!", "type": "상호"}, {"label": "MID_SV_Meal_Bon_Lys_m01_02", "name": "보나파르트", "text": "호오, 좋은 미소군.<br>소녀들의 마음이 흔들리는 것도 당연한가.", "type": "상호"}, {"label": "MID_SV_Meal_Mic_Moo1_m01_01", "name": "무우", "text": "이제 어린애가 아니니까<br>식사할 때만큼은 잔소리 좀 하지 마!", "type": "상호"}, {"label": "MID_SV_Meal_Mic_Moo1_m01_02", "name": "미카엘라", "text": "어린애가 아니라면 편식하지 말고<br>골고루 먹어!", "type": "상호"}, {"label": "MID_SV_Meal_Lil_Lys_m01_01", "name": "라이선더", "text": "안 그래도 너와 대화를 나누고 싶었다.<br>오늘은 마음껏 이야기하지 않겠나.", "type": "상호"}, {"label": "MID_SV_Meal_Lil_Lys_m01_02", "name": "릴리안", "text": "왠지 귀찮을 것 같은데……<br>뭐, 식사하는 동안만이라도 괜찮다면 어울려 줄게~", "type": "상호"}, {"label": "MID_SV_Meal_Lou_Buc_m01_01", "name": "루루디아", "text": "버커니어씨는 식사 예절도 완벽하네요……<br>함께 식사하다 보면 기분이 좋아져요!", "type": "상호"}, {"label": "MID_SV_Meal_Lou_Buc_m01_02", "name": "버커니어", "text": "당연하지. 부하의 예의가 형편없으면<br>주군이 비웃음거리가 되니 말이야.", "type": "상호"}, {"label": "MID_SV_Meal_Led_Asw_m01_01", "name": "아스완", "text": "저, 서민처럼 먹는 방법을 훈련하고 있어요.<br>언젠가 보여 드릴게요.", "type": "상호"}, {"label": "MID_SV_Meal_Led_Asw_m01_02", "name": "레다", "text": "물론 처음 만났을 때는 신분을 숨기라고 했지만……<br>더 이상 서민인 척하지 않아도 될 것 같은데?", "type": "상호"}, {"label": "MID_SV_Meal_Led_Moo0_m01_01", "name": "레다", "text": "……그렇게 빤히 쳐다보지 말고<br>너도 빨리 먹어.", "type": "상호"}, {"label": "MID_SV_Meal_Led_Moo0_m01_02", "name": "무우", "text": "에헤헤…… 레다씨가 우아하게 먹어서<br>나도 모르게 넋을 잃고 봤어.", "type": "상호"}, {"label": "MID_SV_Meal_Lor0_Set_m01_01", "name": "세테스", "text": "잘 듣게, 로레타. 품위는 먹는 모습에서도 드러난다.<br>숟가락은 이렇게 잡고 천천히……", "type": "상호"}, {"label": "MID_SV_Meal_Lor0_Set_m01_02", "name": "로레타", "text": "으엑…… 밥 먹을 때만큼은<br>설교 좀 안 하면 안 되나……", "type": "상호"}]